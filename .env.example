# ============================================
# 飞书配置
# ============================================
# 飞书群机器人 Webhook 地址
# 获取方式：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx

# ============================================
# DeepSeek API
# ============================================
# 获取方式：https://platform.deepseek.com → 注册 → API Keys → 创建
# 新用户赠送 500万 tokens，足够用 1-2 个月
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ============================================
# Twitter 采集（可选，用于 RSSHub 方案B）
# ============================================
# 方案A（Nitter RSS）不需要登录
# 方案B（RSSHub）需要 Twitter 账号，用于获取 cookie
# 如果不想填，只用方案A即可
TWITTER_USERNAME=
TWITTER_PASSWORD=